# --- Обязательные ---
# Токен бота от @BotFather
BOT_TOKEN=123456:replace-me
# Случайная строка 16+ символов (A-Z a-z 0-9 _ -). Сгенерировать: openssl rand -hex 24
WEBHOOK_SECRET=replace-with-random-string
# Домен, на который смотрит DNS-запись сервера (без https://)
DOMAIN=planner.example.com
# Публичный адрес приложения (https + тот же домен)
WEBAPP_URL=https://planner.example.com
# Telegram ID тех, кому разрешён доступ, через запятую (узнать свой — бот @userinfobot)
ALLOWED_TELEGRAM_IDS=123456789

# --- Необязательные ---
DEFAULT_TZ=Europe/Moscow
LOG_LEVEL=info
